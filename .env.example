# ==============================================================================
# PAWSWELL ENVIRONMENT CONFIGURATION
# Copy to .env.local for production deployment
# (The application runs out-of-the-box in local mock mode without credentials!)
# ==============================================================================

# NEXT PUBLIC SITE URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AUTH SESSION SECRET (32+ bytes random secret for JWT & OTP hashing)
SESSION_SECRET=your_32_plus_character_random_session_secret

# RAZORPAY PAYMENT GATEWAY
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_CURRENCY=USD

# RESEND (Email OTP & Transactional Emails)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=PawsWell <onboarding@resend.dev>
NEWSLETTER_FROM_EMAIL=PawsWell <onboarding@resend.dev>

# ADMIN CREDENTIALS (for secure seed script)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password

# MONGODB ATLAS CLUSTER (Live Production Database)
MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/pawswell?retryWrites=true&w=majority
MONGODB_DB_NAME=pawswell

